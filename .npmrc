# Project specific (Keep your existing Web3/Zod config)
public-hoist-pattern[]=*zod*
public-hoist-pattern[]=*@noble*
public-hoist-pattern[]=*@privy-io*

# React Native & Expo Core (Wajib untuk monorepo)
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*

# Essential Native Modules & Navigation
public-hoist-pattern[]=*@react-navigation*
public-hoist-pattern[]=*react-native-*

# Styling & Linting (Opsional tapi membantu)
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*

# Shamefully hoist tetap true agar library native lama tidak pecah
shamefully-hoist=true

# Menangani peer dependencies yang sering bikin expo-doctor komplain
auto-install-peers=true