# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results

# next.js
/.next/
/out/

# production
/build
/dist
apps/*/dist/
**/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.base-sepolia
!.env.mantle-sepolia
!.env.lisk-sepolia

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vscode

# Directories to ignore
playwright-report/
/backend/
/smart-contract/
tests/screenshots/
monitoring-tools/
/marker-maker-bot/
examples/

# Turbo cache
.turbo/

# bv (beads viewer) local config and caches
.bv/
