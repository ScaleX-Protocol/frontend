# Create account at https://www.privy.io/ and get your App ID
VITE_PRIVY_APP_ID=your-privy-app-id

# World App Mini App — register at https://developer.worldcoin.org
VITE_WORLD_APP_ID=app_your_world_app_id

# Backend Environment
# Set to 'local' to use localhost endpoints, otherwise uses deployed endpoints
VITE_BACKEND_ENV=local

# Chain Configuration
VITE_CHAIN_NAME=Base Sepolia
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org
VITE_WS_URL=wss://sepolia.base.org
VITE_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Application Configuration
VITE_APP_NAME=ScaleX
VITE_APP_DESCRIPTION=ScaleX Trading Platform
VITE_DOMAIN=localhost:3000
VITE_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# API Configuration
VITE_API_URL=https://api.scalex.money
VITE_WS_API_URL=wss://api.scalex.money/ws
VITE_INDEXER_URL=https://api.scalex.money/graphql

# Wallet Configuration
VITE_WALLETCONNECT_PROJECT_ID=
VITE_PRIVY_APP_ID=

# Feature Flags
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_SENTRY=false
VITE_FEATURE_ERROR_REPORTING=true
VITE_FEATURE_DEBUG=true
VITE_FEATURE_EXPERIMENTAL=true

# Trading Configuration
VITE_DEFAULT_SLIPPAGE=0.5
VITE_MAX_SLIPPAGE=5.0
VITE_MIN_TRADE_AMOUNT=0.001
VITE_MAX_TRADE_AMOUNT=1000

# Network Configuration
VITE_POLLING_INTERVAL=4000
VITE_MAX_REQUESTS_PER_SECOND=10
VITE_RETRY_ATTEMPTS=3