# Lisk Sepolia Environment Variables
NODE_ENV=production
VITE_CHAIN_TYPE=evm
VITE_PRIVY_APP_ID=cmi4buwlg010ijv0dlp768ac4
VITE_BACKEND_ENV=staging

# Chain Configuration
VITE_CHAIN_NAME=Lisk Sepolia Testnet
VITE_CHAIN_ID=4202
VITE_RPC_URL=https://rpc.sepolia-api.lisk.com
VITE_WS_URL=wss://rpc.sepolia-api.lisk.com
VITE_BLOCK_EXPLORER_URL=https://sepolia-blockscout.lisk.com/

# Application Configuration
VITE_APP_NAME=ScaleX - Lisk Sepolia
VITE_APP_DESCRIPTION=ScaleX Trading Platform on Lisk Sepolia
VITE_DOMAIN=lisk-sepolia-app.scalex.money
VITE_BASE_URL=https://lisk-sepolia-app.scalex.money
VITE_APP_ENV=staging

# API Configuration
VITE_API_URL=https://lisk-sepolia-api.scalex.money
VITE_INDEXER_API_URL=https://lisk-sepolia-indexer.scalex.money
VITE_WS_API_URL=wss://lisk-sepolia-websocket.scalex.money

# Contract Addresses (Lisk Sepolia) - To be updated
VITE_ORDERBOOK_CONTRACT=
VITE_TOKEN_REGISTRY_CONTRACT=
VITE_POOL_MANAGER_CONTRACT=
VITE_BALANCE_MANAGER_CONTRACT=
VITE_SCALEX_ROUTER_CONTRACT=
VITE_LENDING_MANAGER_CONTRACT=
VITE_ORACLE_CONTRACT=

# Wallet Configuration
VITE_WALLETCONNECT_PROJECT_ID=

# Feature Flags
VITE_FEATURE_ANALYTICS=false
VITE_FEATURE_SENTRY=false
VITE_FEATURE_ERROR_REPORTING=true
VITE_FEATURE_DEBUG=true
VITE_FEATURE_EXPERIMENTAL=true

# Trading Configuration
VITE_DEFAULT_SLIPPAGE=0.5
VITE_MAX_SLIPPAGE=5.0
VITE_MIN_TRADE_AMOUNT=0.001
VITE_MAX_TRADE_AMOUNT=1000

# Network Configuration
VITE_POLLING_INTERVAL=4000
VITE_MAX_REQUESTS_PER_SECOND=10
VITE_RETRY_ATTEMPTS=3

# Infrastructure
ACME_EMAIL=admin@scalex.money
REDIS_PASSWORD=  # Set in GitHub Secrets

# Ports
PORT=3000
NGINX_PORT=80
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080

# Docker
COMPOSE_PROJECT_NAME=scalex-lisk-sepolia
CONTAINER_NAME=scalex-frontend-lisk-sepolia

# Monitoring
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_RETRIES=3
