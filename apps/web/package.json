{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite --port 3000",
    "build": "pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "lint": "eslint --max-warnings=1000",
    "lint:fix": "eslint --max-warnings=1000 --fix",
    "typecheck": "tsc --noEmit",
    "install:no-optional": "pnpm install --no-optional",
    "dev:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && pnpm exec vite",
    "dev:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && pnpm exec vite",
    "build:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && pnpm exec vite build",
    "build:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && pnpm exec vite build",
    "build:base-sepolia:docker": "rm -f .env && cp .env.base-sepolia .env && pnpm exec vite build",
    "build:mantle-sepolia:docker": "rm -f .env && cp .env.mantle-sepolia .env && pnpm exec vite build",
    "preview:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && pnpm exec vite preview",
    "preview:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && pnpm exec vite preview",
    "docker:build:base-sepolia": "docker build -t scalex-frontend:base-sepolia --build-arg CHAIN=base-sepolia .",
    "docker:build:mantle-sepolia": "docker build -t scalex-frontend:mantle-sepolia --build-arg CHAIN=mantle-sepolia .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paper-design/shaders-react": "^0.0.61",
    "@privy-io/react-auth": "^3.8.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@splinetool/react-spline": "^4.1.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-devtools": "^1.141.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "viem": "~2.38.6",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.26",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-pwa": "^1.2.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=1000 --fix"
    ]
  }
}