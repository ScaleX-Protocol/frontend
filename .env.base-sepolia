NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Application Configuration
NEXT_PUBLIC_APP_NAME=ScaleX - Base Sepolia
NEXT_PUBLIC_APP_DESCRIPTION=ScaleX Trading Platform on Base Sepolia
NEXT_PUBLIC_DOMAIN=base-sepolia-app.scalex.money
NEXT_PUBLIC_BASE_URL=https://base-sepolia-app.scalex.money
