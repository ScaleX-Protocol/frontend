NEXT_PUBLIC_FEATURE_DEBUG=true
NEXT_PUBLIC_FEATURE_EXPERIMENTAL=true

# Trading Configuration
NEXT_PUBLIC_DEFAULT_SLIPPAGE=0.5
NEXT_PUBLIC_MAX_SLIPPAGE=5.0
NEXT_PUBLIC_MIN_TRADE_AMOUNT=0.001
NEXT_PUBLIC_MAX_TRADE_AMOUNT=1000

# Network Configuration
NEXT_PUBLIC_POLLING_INTERVAL=4000
NEXT_PUBLIC_MAX_REQUESTS_PER_SECOND=10
