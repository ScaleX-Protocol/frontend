# API Configuration
NEXT_PUBLIC_API_URL=https://base-sepolia-indexer.scalex.money
NEXT_PUBLIC_WS_API_URL=wss://base-sepolia-indexer.scalex.money/ws
NEXT_PUBLIC_GRAPHQL_URL=https://base-sepolia-indexer.scalex.money/graphql

# Contract Addresses (Base Sepolia)
NEXT_PUBLIC_ORDERBOOK_CONTRACT=
NEXT_PUBLIC_TOKEN_REGISTRY_CONTRACT=
