{
  "name": "scalex-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build:web:base-sepolia": "turbo run build:base-sepolia --filter=web",
    "build:web:mantle-sepolia": "turbo run build:mantle-sepolia --filter=web",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "husky": "^9.1.7",
    "turbo": "^2.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@privy-io/react-auth": "^3.8.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-router": "^1.141.2",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "viem": "~2.38.6",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "overrides": {
      "preact": ">=10.28.2",
      "hono": ">=4.11.4"
    },
    "neverBuiltDependencies": [
      "bufferutil",
      "utf-8-validate"
    ]
  }
}