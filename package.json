{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint --max-warnings=1000",
    "typecheck": "tsc --noEmit",
    "install:no-optional": "pnpm install --no-optional",
    "dev:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next dev --webpack",
    "dev:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next dev --webpack",
    "build:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next build --webpack",
    "build:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next build --webpack",
    "start:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next start",
    "start:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next start",
    "docker:build:base-sepolia": "docker build -t scalex-frontend:base-sepolia --build-arg CHAIN=base-sepolia .",
    "docker:build:mantle-sepolia": "docker build -t scalex-frontend:mantle-sepolia --build-arg CHAIN=mantle-sepolia .",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paper-design/shaders-react": "^0.0.61",
    "@privy-io/react-auth": "^3.8.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@splinetool/react-spline": "^4.1.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "gsap": "^3.14.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.26",
    "next": "16.0.10",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.68.0",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "viem": "~2.38.6",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.26",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "pnpm run lint --fix"
    ]
  }
}
