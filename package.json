{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=1000",
    "typecheck": "tsc --noEmit",
    "install:no-optional": "pnpm install --no-optional",
    
    "dev:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next dev",
    "dev:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next dev",
    
    "build:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next build",
    "build:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next build",
    
    "start:base-sepolia": "rm -f .env && cp .env.base-sepolia .env && next start",
    "start:mantle-sepolia": "rm -f .env && cp .env.mantle-sepolia .env && next start",
    
        
    "docker:build:base-sepolia": "docker build -t scalex-frontend:base-sepolia --build-arg CHAIN=base-sepolia .",
    "docker:build:mantle-sepolia": "docker build -t scalex-frontend:mantle-sepolia --build-arg CHAIN=mantle-sepolia .",
    
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --config=playwright.visual.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@paper-design/shaders-react": "^0.0.61",
    "@privy-io/react-auth": "^3.6.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@splinetool/react-spline": "^4.1.0",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "16.0.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.66.0",
    "tailwind-merge": "^3.3.1",
    "viem": "~2.38.6",
    "wagmi": "^2.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
